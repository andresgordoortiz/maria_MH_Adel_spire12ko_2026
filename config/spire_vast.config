// The shared config evaluates these parameters while it is being loaded.
params.vastdb_path = System.getenv('VASTDB')
params.outdir = "${System.getenv('PROJECT_DIR')}/results/spire_fastq/vast"
includeConfig "${System.getenv('VAST_PIPELINE')}/nextflow.config"

report.overwrite = true
timeline.overwrite = true
trace.overwrite = true
dag.overwrite = true

env.SINGULARITY_BINDPATH = "${params.vastdb_path}:/usr/local/vast-tools/VASTDB:ro"
process {
    withName: 'align_reads' {
        errorStrategy = 'retry'
        time = { 50.h * task.attempt }
    }
    withName: 'align_reads|combine_results|compare_groups' {
        containerOptions = "--bind \"${params.vastdb_path}:/usr/local/vast-tools/VASTDB:ro,${params.vastdb_path}:${params.vastdb_path}:ro\""
    }
}
